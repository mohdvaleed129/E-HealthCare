<!DOCTYPE html>
<html lang="en">
<head>
{{> head title="Log in"}}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{{> navbar}}
<main id="main">
  <div class="container section">
    {{> alert}}
    <div class="form-card">
      <h1 style="font-size:1.5rem;">Log in</h1>
      <p class="text-sm text-muted">Choose your account type and enter your credentials.</p>
      <form action="/login" method="POST" novalidate>
        <div class="field">
          <label for="role">I am a</label>
          <select id="role" name="role" required>
            <option value="patient">Patient</option>
            <option value="doctor">Doctor</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div class="field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" autocomplete="current-password" required />
        </div>
        <button class="btn btn-primary btn-block" type="submit">Log in</button>
      </form>
      <p class="text-sm mt-lg mb-0">
        Don't have an account? <a href="/signup">Sign up as a patient</a> or <a href="/doctor/signup">apply as a doctor</a>.
      </p>
    </div>
  </div>
</main>
{{> footer}}
<script src="/js/app.js"></script>
</body>
</html>
