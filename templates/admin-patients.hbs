<!DOCTYPE html>
<html lang="en">
<head>
{{> head title="Manage patients"}}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{{> navbar}}
<main id="main">
  <div class="container section">
    {{> alert}}
    <h1>Manage patients</h1>

    <div class="dashboard">
      <aside class="dashboard__sidebar">
        <nav aria-label="Admin sections">
          <a href="/admin">Overview</a>
          <a href="/admin/doctors">Doctors</a>
          <a href="/admin/patients" class="is-active">Patients</a>
          <a href="/admin/appointments">Appointments</a>
        </nav>
      </aside>

      <div class="dashboard__main">
        <form action="/admin/patients" method="GET" class="search-bar" style="margin-bottom:20px;">
          <input type="search" name="q" placeholder="Search by name…" value="{{query}}" />
          <button class="btn btn-primary" type="submit">Search</button>
        </form>

        {{#if patients.length}}
          <div class="table-wrap">
            <table>
              <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Action</th></tr></thead>
              <tbody>
                {{#each patients}}
                  <tr>
                    <td>{{this.name}}</td>
                    <td>{{this.email}}</td>
                    <td>{{#if this.phone}}{{this.phone}}{{else}}—{{/if}}</td>
                    <td><span class="badge {{badgeClass this.status}}">{{this.status}}</span></td>
                    <td>
                      <div class="flex gap-sm">
                        {{#if (eq this.status "active")}}
                          <form action="/admin/patients/{{this._id}}/status" method="POST" data-confirm="Suspend this account?">
                            <input type="hidden" name="status" value="suspended" />
                            <button class="btn btn-danger btn-sm" type="submit">Suspend</button>
                          </form>
                        {{else}}
                          <form action="/admin/patients/{{this._id}}/status" method="POST">
                            <input type="hidden" name="status" value="active" />
                            <button class="btn btn-secondary btn-sm" type="submit">Reactivate</button>
                          </form>
                        {{/if}}
                          <form action="/admin/patients/{{this._id}}/delete" method="POST" data-confirm="Permanently delete {{this.name}}'s account? This cannot be undone.">
                            <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                          </form>
                      </div>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="state-block"><h3>No patients found</h3></div>
        {{/if}}
      </div>
    </div>
  </div>
</main>
{{> footer}}
<script src="/js/app.js"></script>
</body>
</html>
