<!DOCTYPE html>
<html lang="en">
<head>
{{> head title="Manage doctors"}}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{{> navbar}}
<main id="main">
  <div class="container section">
    {{> alert}}
    <h1>Manage doctors</h1>

    <div class="dashboard">
      <aside class="dashboard__sidebar">
        <nav aria-label="Admin sections">
          <a href="/admin">Overview</a>
          <a href="/admin/doctors" class="is-active">Doctors</a>
          <a href="/admin/patients">Patients</a>
          <a href="/admin/appointments">Appointments</a>
        </nav>
      </aside>

      <div class="dashboard__main">
        <form action="/admin/doctors" method="GET" class="search-bar" style="margin-bottom:20px;">
          <input type="search" name="q" placeholder="Search by name…" value="{{query}}" />
          <select name="status">
            <option value="">All statuses</option>
            <option value="pending" {{#if (eq statusFilter "pending")}}selected{{/if}}>Pending</option>
            <option value="approved" {{#if (eq statusFilter "approved")}}selected{{/if}}>Approved</option>
            <option value="rejected" {{#if (eq statusFilter "rejected")}}selected{{/if}}>Rejected</option>
            <option value="suspended" {{#if (eq statusFilter "suspended")}}selected{{/if}}>Suspended</option>
          </select>
          <button class="btn btn-primary" type="submit">Filter</button>
        </form>

        {{#if doctors.length}}
          <div class="table-wrap">
            <table>
              <thead><tr><th>Name</th><th>Specialization</th><th>Email</th><th>Status</th><th>Action</th></tr></thead>
              <tbody>
                {{#each doctors}}
                  <tr>
                    <td>Dr. {{this.name}}</td>
                    <td>{{this.specialization}}</td>
                    <td>{{this.email}}</td>
                    <td><span class="badge {{badgeClass this.status}}">{{this.status}}</span></td>
                    <td>
                      <div class="flex gap-sm">
                        {{#unless (eq this.status "approved")}}
                        <form action="/admin/doctors/{{this._id}}/status" method="POST">
                          <input type="hidden" name="status" value="approved" />
                          <button class="btn btn-secondary btn-sm" type="submit">Approve</button>
                        </form>
                        {{/unless}}
                        {{#unless (eq this.status "rejected")}}
                        <form action="/admin/doctors/{{this._id}}/status" method="POST">
                          <input type="hidden" name="status" value="rejected" />
                          <button class="btn btn-danger btn-sm" type="submit">Reject</button>
                        </form>
                        {{/unless}}
                        {{#unless (eq this.status "suspended")}}
                        <form action="/admin/doctors/{{this._id}}/status" method="POST" data-confirm="Suspend Dr. {{this.name}}?">
                          <input type="hidden" name="status" value="suspended" />
                          <button class="btn btn-ghost btn-sm" type="submit">Suspend</button>
                        </form>
                        <form action="/admin/doctors/{{this._id}}/delete" method="POST" data-confirm="Permanently delete Dr. {{this.name}}? This cannot be undone.">
                          <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                        </form>
                        {{/unless}}
                      </div>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="state-block"><h3>No doctors match</h3><p class="mb-0">Try clearing the filters.</p></div>
        {{/if}}
      </div>
    </div>
  </div>
</main>
{{> footer}}
<script src="/js/app.js"></script>
</body>
</html>
