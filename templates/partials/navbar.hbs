<header class="navbar">
  <div class="navbar__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">C</span>
      CareStem
    </a>
    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation menu">
      ☰
    </button>
    <nav id="primary-nav" aria-label="Primary">
      <ul class="nav-links" data-nav-links>
        <li><a href="/doctors">Find a doctor</a></li>
        {{#if isAuthenticated}}
          {{#if (eq currentUser.role "patient")}}
            <li><a href="/appointments">My appointments</a></li>
            <li><a href="/profile">Profile</a></li>
          {{/if}}
          {{#if (eq currentUser.role "doctor")}}
            <li><a href="/doctor/dashboard">Dashboard</a></li>
          {{/if}}
          {{#if (eq currentUser.role "admin")}}
            <li><a href="/admin">Admin</a></li>
          {{/if}}
        {{else}}
          <li><a href="/doctor/signup">For doctors</a></li>
        {{/if}}
      </ul>
    </nav>
    <div class="nav-actions">
      {{#if isAuthenticated}}
        <form action="/logout" method="POST">
          <button class="btn btn-secondary btn-sm" type="submit">Log out</button>
        </form>
      {{else}}
        <a class="btn btn-ghost btn-sm" href="/login">Log in</a>
        <a class="btn btn-primary btn-sm" href="/signup">Sign up</a>
      {{/if}}
    </div>
  </div>
</header>
